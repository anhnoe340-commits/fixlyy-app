# ============================================================
# Fixlyy — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# Toutes les variables VITE_* sont exposées au frontend.
# Les autres sont uniquement pour les Edge Functions (Supabase Secrets).
# ============================================================

# ── Supabase (frontend) ──────────────────────────────────────
# https://app.supabase.com → Settings → API
VITE_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Supabase (edge functions — à configurer via Supabase Secrets) ──
# Déjà injectées automatiquement dans les edge functions :
# SUPABASE_URL, SUPABASE_ANON_KEY, FIXLYY_SERVICE_ROLE_KEY
# Ces 3 variables ne sont pas à redéclarer manuellement.

# ── Twilio ───────────────────────────────────────────────────
# https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Numéro Twilio fixe pour envoyer les SMS (ex: numéro de garde)
TWILIO_PHONE_NUMBER=+33XXXXXXXXX

# ── Vapi ─────────────────────────────────────────────────────
# https://dashboard.vapi.ai → Organization Settings → API Keys
VAPI_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# L'assistant Vapi utilisé par défaut pour les appels test et l'onboarding
# Récupérer via: curl -H "Authorization: Bearer $VAPI_API_KEY" https://api.vapi.ai/assistant
VAPI_DEFAULT_ASSISTANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Secret pour valider les webhooks Vapi entrants
VAPI_WEBHOOK_SECRET=votre_secret_webhook_vapi

# ── Stripe ───────────────────────────────────────────────────
# https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
# https://dashboard.stripe.com → Developers → Webhooks → votre endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# L'ID du price Stripe pour l'abonnement mensuel
STRIPE_PRICE_ID=price_xxxxxxxxxxxx

# ── Resend (emails transactionnels) ──────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Google Calendar OAuth ─────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://hxkpmmekaotwmzgqxafp.supabase.co/functions/v1/google-calendar-callback

# ── Alertes opérationnelles ───────────────────────────────────
# Numéro mobile (E.164) qui reçoit les alertes critiques (pool vide, etc.)
ALERT_PHONE=+33XXXXXXXXX

# ── Pool de numéros Twilio ────────────────────────────────────
# Seuil en dessous duquel le cron achète de nouveaux numéros
REPLENISH_THRESHOLD=5
# Quantité totale cible après replenishment
REPLENISH_TARGET=10

# ── App ───────────────────────────────────────────────────────
APP_URL=https://app.fixlyy.fr
# Secret partagé entre les crons et les edge functions (générer via: openssl rand -hex 32)
CRON_SECRET=votre_secret_cron_32_chars_minimum

# ── Feature flags ─────────────────────────────────────────────
# Activer le nouvel onboarding V2 (sans CB, trial 7j)
VITE_USE_NEW_ONBOARDING=true
